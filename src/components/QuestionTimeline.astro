---
interface Props {
  question: any;
  evidence: {
    year: number;
    title: string;
    paper: string;
  }[];
}

const { question, evidence } = Astro.props;
const sortedEvidence = evidence.sort((a, b) => a.year - b.year);

// Calculate timeline range
const years = sortedEvidence.map(e => e.year);
const minYear = Math.min(...years);
const maxYear = Math.max(...years);
const yearRange = maxYear - minYear || 1;
---

<div class="question-timeline">
  <h3>{question.title}</h3>
  <p class="area">Area: <span>{question.area}</span></p>

  <div class="timeline-container">
    <div class="timeline-axis">
      <div class="timeline-line"></div>

      {sortedEvidence.map((event) => {
        const position = ((event.year - minYear) / yearRange) * 100;
        return (
          <div
            class="timeline-event"
            style={{ left: `${position}%` }}
            title={event.title}
          >
            <div class="event-dot"></div>
            <div class="event-label">
              <div class="event-year">{event.year}</div>
              <div class="event-title">{event.title}</div>
              <div class="event-paper">
                <a href={`/papers/${event.paper}/`}>View paper</a>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="timeline-years">
      <span class="year-start">{minYear}</span>
      <span class="year-end">{maxYear}</span>
    </div>
  </div>

  <div class="timeline-summary">
    <p>
      This question has been studied for <strong>{maxYear - minYear} years</strong>,
      with {sortedEvidence.length} papers examining it from different angles.
    </p>
  </div>
</div>

<style>
  .question-timeline {
    margin: 2rem 0;
    padding: 1.5rem;
    border-left: 4px solid var(--accent);
    background: var(--card-bg);
    border-radius: 8px;
  }

  h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.2rem;
  }

  .area {
    margin: 0.5rem 0 1.5rem 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .area span {
    font-weight: 600;
    color: var(--text-primary);
  }

  .timeline-container {
    position: relative;
    height: 150px;
    margin: 2rem 0;
  }

  .timeline-axis {
    position: relative;
    height: 100%;
  }

  .timeline-line {
    position: absolute;
    top: 40px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      to right,
      var(--accent-light),
      var(--accent),
      var(--accent-light)
    );
  }

  .timeline-event {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 120px;
    margin-left: -60px;
  }

  .event-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg);
    box-shadow: 0 0 0 3px var(--accent-light);
    margin-top: 34px;
    z-index: 2;
  }

  .event-label {
    margin-top: 12px;
    text-align: center;
    background: var(--bg);
    padding: 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    max-width: 120px;
  }

  .event-year {
    font-weight: 700;
    color: var(--accent);
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .event-title {
    font-size: 0.75rem;
    color: var(--text-primary);
    line-height: 1.3;
    margin-bottom: 0.5rem;
    word-break: break-word;
  }

  .event-paper a {
    font-size: 0.7rem;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    transition: opacity 0.2s;
  }

  .event-paper a:hover {
    opacity: 0.7;
  }

  .timeline-years {
    display: flex;
    justify-content: space-between;
    padding: 0 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 2rem;
    font-weight: 600;
  }

  .timeline-summary {
    margin-top: 1.5rem;
    padding: 1rem;
    background: var(--bg);
    border-radius: 6px;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .timeline-summary p {
    margin: 0;
  }
</style>
