---
import KindBadge from './KindBadge.astro';
import { DOMAINS, PARTICIPANTS, RELATIONS, SETTINGS } from '../content.config';
import { claimUrl, evidenceBadge, paperLink, shortCite, url, type Evidence } from '../lib/graph';

interface Props {
  items: Evidence[];
  /** Which linked entities to show alongside each item. */
  show?: ('question' | 'claim')[];
}
const { items, show = [] } = Astro.props;
const statement = (e: Evidence, id: string) => e.claim.data.propositions.find((p) => p.id === id)?.statement;
---
<ul class="evidence">
  {items.map((e) => (
    <li>
      <div class="head">
        <span class={`badge ${evidenceBadge(e)}`}>{evidenceBadge(e)}</span>
        <a href={url(`/papers/#${e.paper.id}`)}><strong>{shortCite(e.paper)}</strong></a>
        <span class="muted" title={RELATIONS[e.relation]}>{e.relation === 'post-hoc' ? 'post-hoc explanation' : e.relation}</span>
        {show.includes('claim') && <><KindBadge claim={e.claim} /><a href={claimUrl(e.claim)}>{e.claim.data.name}</a></>}
        {e.rival && <span class="muted">against <a href={claimUrl(e.rival)}>{e.rival.data.name}</a></span>}
      </div>
      {show.includes('question') && (
        <div class="meta">
          On: <a href={url(`/questions/${e.question.id}/`)}>{e.question.data.title}</a>
        </div>
      )}
      {e.propositions.length > 0 && (
        <div class="badges" style="margin:4px 0">
          {e.propositions.map((id) => <a class="badge prop" href={`${claimUrl(e.claim)}#prop-${id}`} title={statement(e, id)}>{id}</a>)}
        </div>
      )}
      <p class="note">{e.mirrored && <span class="muted">(Rival side of a comparison.) </span>}{e.note}</p>
      <div class="meta">
        <a href={paperLink(e.paper)}>{e.paper.data.title}</a>, {e.paper.data.venue}
        {e.methods.length > 0 && <> · Method: {e.methods.map((m, i) => (
          <>{i > 0 && ', '}<a href={url(`/methods/${m.id}/`)}>{m.data.name}</a></>
        ))}</>}
        {e.context && <> · {SETTINGS[e.context.setting]}, {PARTICIPANTS[e.context.participants].toLowerCase()}, {DOMAINS[e.context.domain].toLowerCase()}</>}
      </div>
    </li>
  ))}
</ul>
