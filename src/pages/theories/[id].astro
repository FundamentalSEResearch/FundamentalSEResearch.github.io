---
import ClaimPage from '../../components/ClaimPage.astro';
import { loadGraph } from '../../lib/graph';

export async function getStaticPaths() {
  const g = await loadGraph();
  return g.theories.map((claim) => ({ params: { id: claim.id }, props: { claim } }));
}
---
<ClaimPage claim={Astro.props.claim} />
