---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import QuestionTimelineDetail from '../../components/QuestionTimelineDetail.astro';
import KindBadge from '../../components/KindBadge.astro';
import TallyBadges from '../../components/TallyBadges.astro';
import { AREAS } from '../../content.config';
import { claimKey, claimUrl, groupBy, kindOf, loadGraph, paperLink, shortCite, tally } from '../../lib/graph';

export async function getStaticPaths() {
  const g = await loadGraph();
  return g.questions.map((q) => ({ params: { id: q.id }, props: { id: q.id } }));
}

const g = await loadGraph();
const q = g.questions.find((x) => x.id === Astro.props.id)!;
const { Content } = await render(q);
const byClaim = [...groupBy(g.forQuestion(q.id), (e) => e.claim).entries()];
const sections = [
  { kind: 'law', heading: 'Laws: what happens', blurb: 'Regularities proposed as the answer, and whether studies find them.' },
  { kind: 'theory', heading: 'Theories: why it happens', blurb: 'Proposed mechanisms, and whether studies support them.' },
].map((s) => ({ ...s, rows: byClaim.filter(([c]) => kindOf(c) === s.kind) }));
// Head-to-head tests between rival answers (Ralph 2015). Each comparison is listed once, from the recorded side.
const comparisons = g.recorded.filter((e) => e.question.id === q.id && e.rival);
---
<Base title={q.data.title} description={q.data.summary}>
  <p class="eyebrow">Question · {AREAS[q.data.area]}</p>
  <h1>{q.data.title}</h1>
  <p class="lede">{q.data.summary}</p>

  <div class="prose"><Content /></div>

  <QuestionTimelineDetail
    evidence={g.forQuestion(q.id).map((e) => ({
      paper: e.paper,
      claim: e.claim,
      relation: e.relation,
      finding: e.finding,
      year: e.paper.data.year,
    }))}
  />

  <h2>Candidate answers</h2>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Law or theory</th><th>Type</th><th>Evidence on this question</th></tr></thead>
      <tbody>
        {byClaim.map(([c, ev]) => (
          <tr>
            <td><a href={`#${claimKey(c)}`}>{c.data.name}</a></td>
            <td><KindBadge claim={c} /></td>
            <td><TallyBadges tally={tally(ev)} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {comparisons.length > 0 && (
    <>
      <h2>Head-to-head comparisons</h2>
      <p class="muted">Studies that tested rival answers against each other, which is more informative than testing one answer against a null hypothesis.</p>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Study</th><th>Compared</th><th>Result</th></tr></thead>
          <tbody>
            {comparisons.map((e) => (
              <tr>
                <td><a href={paperLink(e.paper)}>{shortCite(e.paper)}</a></td>
                <td><a href={claimUrl(e.claim)}>{e.claim.data.name}</a> vs. <a href={claimUrl(e.rival!)}>{e.rival!.data.name}</a></td>
                <td>
                  {e.finding === 'supports' ? <>Favors <strong>{e.claim.data.name}</strong></>
                    : e.finding === 'refutes' ? <>Favors <strong>{e.rival!.data.name}</strong></>
                    : 'Neither clearly favored'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {sections.filter((s) => s.rows.length).map((s) => (
    <>
      <h2>{s.heading}</h2>
      <p class="muted">{s.blurb}</p>
      {s.rows.map(([c, ev]) => (
        <section class="theory-block" id={claimKey(c)}>
          <h3>
            <a href={claimUrl(c)}>{c.data.name}</a>
            <span class="muted" style="font-family:var(--font);font-weight:400;font-size:0.95rem">{c.data.summary}</span>
          </h3>
          <EvidenceList items={ev} />
        </section>
      ))}
    </>
  ))}

  <p class="muted" style="margin-top:32px">
    Know a study that belongs here? <a href="https://github.com/software-engineering-theories">Propose evidence on GitHub</a>.
  </p>
</Base>
